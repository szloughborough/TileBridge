{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git remote:*)",
      "Bash(git gc:*)",
      "Bash(git push:*)",
      "Bash(gh auth:*)",
      "Bash(git ls-remote:*)",
      "Bash(GCM_INTERACTIVE=never GIT_TERMINAL_PROMPT=0 git push github master 2>&1)"
    ]
  },
  "mcpServers": {
    "chrome": {
      "command": "npx",
      "args": [
        "public-browser"
      ]
    }
  }
}
