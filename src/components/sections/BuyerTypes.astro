---
import SectionHeading from '../ui/SectionHeading.astro';
import Grid from '../ui/Grid.astro';
import Card from '../ui/Card.astro';
import { SITE_CONFIG } from '../../lib/siteConfig';
const { buyerTypes } = SITE_CONFIG;
---

<section class="buyer-types">
  <div class="container">
    <SectionHeading
      title="Кому подходит наша продукция"
      subtitle="Работаем с разными типами клиентов — от оптовиков до дизайнеров"
    />
    <Grid cols={3}>
      {buyerTypes.map((type) => (
        <Card class="buyer-card">
          <div class="buyer-card__icon">
            {type.icon === 'warehouse' && (
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><rect x="6" y="10" width="28" height="24" rx="2" stroke="var(--color-primary)" stroke-width="2"/><path d="M6 14h28M12 20h4M12 26h4M22 20h10M22 26h10" stroke="var(--color-accent)" stroke-width="1.5"/><path d="M20 6L6 10h28L20 6z" fill="var(--color-primary)"/></svg>
            )}
            {type.icon === 'store' && (
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><rect x="4" y="12" width="32" height="22" rx="2" stroke="var(--color-primary)" stroke-width="2"/><path d="M8 12l4-6h16l4 6" stroke="var(--color-accent)" stroke-width="2"/><rect x="14" y="20" width="12" height="14" rx="1" fill="var(--color-primary)" opacity="0.15"/></svg>
            )}
            {type.icon === 'online' && (
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><rect x="4" y="8" width="32" height="24" rx="3" stroke="var(--color-primary)" stroke-width="2"/><circle cx="20" cy="20" r="6" stroke="var(--color-accent)" stroke-width="2"/><path d="M16 8h8l-2 4h-4l-2-4z" fill="var(--color-primary)" opacity="0.2"/></svg>
            )}
            {type.icon === 'construction' && (
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><rect x="4" y="14" width="32" height="20" rx="2" stroke="var(--color-primary)" stroke-width="2"/><path d="M12 14V8h16v6" stroke="var(--color-accent)" stroke-width="2"/><line x1="20" y1="8" x2="20" y2="14" stroke="var(--color-accent)" stroke-width="1.5"/></svg>
            )}
            {type.icon === 'design' && (
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="14" stroke="var(--color-primary)" stroke-width="2"/><circle cx="20" cy="20" r="6" stroke="var(--color-accent)" stroke-width="2"/><circle cx="20" cy="20" r="2" fill="var(--color-primary)"/></svg>
            )}
          </div>
          <h3 class="buyer-card__title">{type.title}</h3>
          <p class="buyer-card__desc">{type.description}</p>
        </Card>
      ))}
    </Grid>
  </div>
</section>

<style>
  .buyer-types {
    background: var(--color-bg);
  }

  .buyer-card {
    text-align: center;
    padding: 32px 20px;
  }

  .buyer-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    background: var(--color-bg);
    border-radius: 50%;
  }

  .buyer-card__title {
    margin-bottom: 8px;
    font-size: 1.1rem;
  }

  .buyer-card__desc {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin: 0;
  }
</style>
