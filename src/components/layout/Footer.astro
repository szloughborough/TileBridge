---
import { SITE_CONFIG } from '../../lib/siteConfig';
const { company, navigation, categories } = SITE_CONFIG;
---

<footer class="footer">
  <div class="container">
    <div class="footer__cta">
      <h2 class="footer__cta-title">Готовы начать сотрудничество?</h2>
      <p class="footer__cta-text">Свяжитесь с нами для получения оптовых цен и образцов продукции.</p>
      <a href="/kontakty/" class="footer__cta-btn">Отправить запрос</a>
    </div>

    <div class="footer__grid">
      <div class="footer__col">
        <div class="footer__brand">
          <strong>TileBridge</strong>
          <p>{company.tagline}</p>
        </div>
        <div class="footer__contacts">
          <a href={`mailto:${company.email}`}>{company.email}</a>
          <a href={`tel:${company.phone}`}>{company.phone}</a>
          <p>{company.address}</p>
          <p class="footer__hours">{company.workingHours}</p>
        </div>
        <div class="footer__social">
          <a href={company.telegram} target="_blank" rel="noopener noreferrer" class="footer__social-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.127.007.49.007.49l-1.3 6.19c-.104.473-.466.624-.79.626-.31-.002-.585-.115-.585-.115l-3.41-2.305c-.313-.208-.348-.38-.042-.632l2.59-2.39c.134-.122.158-.165.01-.103l-3.58 2.155c-.17.098-.347.15-.498.132-.19-.023-.358-.105-.358-.105l-1.334-.44c-.32-.102-.44-.33-.08-.497l6.448-2.77c.295-.13.574-.055.68.023z"/></svg>
          </a>
          <a href={company.whatsapp} target="_blank" rel="noopener noreferrer" class="footer__social-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Продукция</h4>
        <ul class="footer__links">
          {categories.map((cat) => (
            <li><a href={`/productiya/${cat.slug}/`}>{cat.title}</a></li>
          ))}
          <li><a href="/productiya/">Все продукты</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Информация</h4>
        <ul class="footer__links">
          {navigation.filter(n => n.label !== 'Продукция' && n.label !== 'Главная').map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Свяжитесь с нами</h4>
        <p class="footer__response">{company.responseTime}</p>
        <a href="/kontakty/" class="footer__btn">Написать нам</a>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {new Date().getFullYear()} TileBridge. Все права защищены.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary);
    color: var(--color-white);
    padding-top: 0;
  }

  .footer__cta {
    text-align: center;
    padding: 60px 20px;
    background: var(--color-accent);
    margin-bottom: 60px;
  }

  .footer__cta-title {
    color: var(--color-white);
    margin-bottom: 12px;
  }

  .footer__cta-text {
    font-size: 1.1rem;
    margin-bottom: 24px;
    opacity: 0.9;
  }

  .footer__cta-btn {
    display: inline-block;
    padding: 14px 36px;
    background: var(--color-white);
    color: var(--color-accent);
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 1rem;
    transition: transform var(--transition);
    text-decoration: none;
  }

  .footer__cta-btn:hover {
    transform: translateY(-2px);
    color: var(--color-accent-dark);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
  }

  .footer__brand strong {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    display: block;
    margin-bottom: 8px;
  }

  .footer__brand p {
    opacity: 0.8;
    font-size: 0.9rem;
  }

  .footer__contacts {
    margin-top: 16px;
    font-size: 0.9rem;
    line-height: 2;
  }

  .footer__contacts a {
    display: block;
    color: var(--color-white);
    opacity: 0.8;
  }

  .footer__contacts a:hover {
    opacity: 1;
    color: var(--color-accent-light);
  }

  .footer__hours {
    opacity: 0.6;
    font-size: 0.8rem;
    margin-top: 4px;
  }

  .footer__social {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    color: var(--color-white);
    transition: background var(--transition);
  }

  .footer__social-link:hover {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .footer__heading {
    color: var(--color-white);
    font-size: 1rem;
    margin-bottom: 16px;
    position: relative;
    padding-bottom: 8px;
  }

  .footer__heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: var(--color-accent);
  }

  .footer__links {
    list-style: none;
    padding: 0;
  }

  .footer__links li {
    margin-bottom: 10px;
  }

  .footer__links a {
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--color-accent-light);
  }

  .footer__response {
    font-size: 0.9rem;
    opacity: 0.8;
    margin-bottom: 16px;
  }

  .footer__btn {
    display: inline-block;
    padding: 10px 24px;
    border: 2px solid var(--color-accent);
    color: var(--color-white);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all var(--transition);
    text-decoration: none;
  }

  .footer__btn:hover {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 20px 0;
    text-align: center;
    font-size: 0.85rem;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
