---
export interface Props {
  class?: string;
  href?: string;
  variant?: 'default' | 'product' | 'bordered';
}

const { class: className, href, variant = 'default' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class={`card card--${variant} ${className || ''}`}>
  <slot />
</Tag>

<style>
  .card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 24px;
    transition: all var(--transition);
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .card--product {
    padding: 0;
    overflow: hidden;
  }

  .card--bordered {
    border: 1px solid var(--color-stone-light);
    box-shadow: none;
  }

  .card--bordered:hover {
    border-color: var(--color-accent);
  }
</style>
