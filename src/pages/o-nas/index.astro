---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Grid from '../../components/ui/Grid.astro';
import Card from '../../components/ui/Card.astro';
import CooperationProcess from '../../components/sections/CooperationProcess.astro';
import CTASection from '../../components/sections/CTASection.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { SITE_CONFIG } from '../../lib/siteConfig';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const productCount = allProducts.length;
const { certifications } = SITE_CONFIG;
---

<BaseLayout
  title="О нас — TileBridge, производитель покрытий из Китая"
  description="Прямой производитель самоклеящейся плитки и ПВХ панелей. 10+ лет экспорта. Собственная фабрика в провинции Гуандун."
>
  <div class="container">
    <Breadcrumb items={[{ label: 'О нас' }]} />
  </div>

  <!-- ===== Hero ===== -->
  <section class="about-hero">
    <div class="container">
      <div class="about-hero__grid">
        <div class="about-hero__content">
          <span class="about-hero__badge">TileBridge Co., Ltd.</span>
          <h1>Мы — ваш прямой<br />производитель в Китае</h1>
          <p class="about-hero__lead">Работаем с B2B-клиентами по всему миру с 2013 года. Собственная фабрика в провинции Гуандун.</p>
          <p>Мы производим самоклеящуюся ПВХ плитку и 3D стеновые панели. Полный цикл: от сырья до отгрузки готовой продукции. Работаем с оптовыми компаниями, розничными сетями, интернет-магазинами и строительными организациями.</p>
          <div class="about-hero__actions">
            <a href="/productiya/" class="about-hero__btn about-hero__btn--primary">Смотреть продукцию</a>
            <a href="/kontakty/" class="about-hero__btn about-hero__btn--secondary">Связаться с нами</a>
          </div>
        </div>
        <div class="about-hero__visual">
          <div class="about-hero__image-wrap">
            <img src="/assets/images/factory/factory-01.jpg" alt="Фабрика TileBridge в Гуандуне" class="about-hero__image" />
            <div class="about-hero__image-badge">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" fill="#25D366"/><path d="M5 8l2 2 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Производство в Гуандуне
            </div>
          </div>
          <div class="about-hero__stats">
            <div class="about-hero__stat">
              <strong>2013</strong>
              <span>Год основания</span>
            </div>
            <div class="about-hero__stat">
              <strong>10+</strong>
              <span>Лет экспорта</span>
            </div>
            <div class="about-hero__stat">
              <strong>{productCount}+</strong>
              <span>Товаров</span>
            </div>
            <div class="about-hero__stat">
              <strong>15</strong>
              <span>Стран</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Numbers Strip ===== -->
  <section class="about-numbers">
    <div class="container">
      <div class="about-numbers__strip">
        <div class="about-numbers__item">
          <strong>10+ лет</strong>
          <span>стабильного экспорта</span>
        </div>
        <div class="about-numbers__divider"></div>
        <div class="about-numbers__item">
          <strong>{productCount}+</strong>
          <span>видов продукции</span>
        </div>
        <div class="about-numbers__divider"></div>
        <div class="about-numbers__item">
          <strong>50 м²</strong>
          <span>минимальный заказ</span>
        </div>
        <div class="about-numbers__divider"></div>
        <div class="about-numbers__item">
          <strong>{SITE_CONFIG.cooperationSteps.length} шагов</strong>
          <span>от запроса до доставки</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Who We Are ===== -->
  <section class="about-who">
    <div class="container">
      <SectionHeading title="Кто мы?" subtitle="Производственная компания с фокусом на качество" />
      <Grid cols={3}>
        <Card class="about-who__card">
          <div class="about-who__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M12 2L2 7l10 5 10-5-10-5z" fill="var(--color-accent)" opacity="0.2"/>
              <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>Специализация</h3>
          <p>Мы производим только ПВХ-покрытия. Это позволяет нам поддерживать стабильное качество и глубоко понимать продукт.</p>
        </Card>
        <Card class="about-who__card">
          <div class="about-who__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="var(--color-accent)" stroke-width="1.5" fill="none"/>
              <circle cx="12" cy="12" r="3" fill="var(--color-accent)" opacity="0.2"/>
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Целевые рынки</h3>
          <p>Основные направления: Россия, Европа, Юго-Восточная Азия, Ближний Восток. Знаем требования каждого рынка.</p>
        </Card>
        <Card class="about-who__card">
          <div class="about-who__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="6" width="20" height="12" rx="2" stroke="var(--color-accent)" stroke-width="1.5" fill="none"/>
              <path d="M8 12h8M12 8v8" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>B2B-фокус</h3>
          <p>Работаем исключительно с бизнес-клиентами. Не конкурируем с вами на розничном рынке.</p>
        </Card>
      </Grid>
    </div>
  </section>

  <!-- ===== Why Work With Us ===== -->
  <section class="about-why">
    <div class="container">
      <SectionHeading title="Почему стоит работать с нами?" centered={false} />
      <div class="about-why__grid">
        <div class="about-why__item">
          <div class="about-why__step">01</div>
          <div class="about-why__content">
            <h3>Продуктовая экспертиза</h3>
            <p>Мы не универсальный поставщик. Мы специализируемся на ПВХ-плитке и знаем о ней всё. Вы получите компетентную консультацию и продукт, который подходит для вашего рынка.</p>
          </div>
        </div>
        <div class="about-why__item">
          <div class="about-why__step">02</div>
          <div class="about-why__content">
            <h3>Стабильное производство</h3>
            <p>Собственная фабрика с полным циклом: от смешивания сырья до упаковки. Мы контролируем каждый этап, поэтому качество стабильно от партии к партии.</p>
          </div>
        </div>
        <div class="about-why__item">
          <div class="about-why__step">03</div>
          <div class="about-why__content">
            <h3>Понимание рынка РФ</h3>
            <p>С 2013 года поставляем продукцию в Россию. Знаем требования к сертификации, таможенному оформлению и упаковке. Предоставляем полный пакет документов.</p>
          </div>
        </div>
        <div class="about-why__item">
          <div class="about-why__step">04</div>
          <div class="about-why__content">
            <h3>Гибкость в кастомизации</h3>
            <p>Упаковка под вашим брендом, индивидуальный дизайн плитки, логотип на продукте — широкие возможности для OEM/ODM.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Certificates ===== -->
  <section class="about-certs">
    <div class="container">
      <SectionHeading title="Сертификаты и стандарты" subtitle="Вся продукция сертифицирована для экспорта в Россию и другие страны" />
      <div class="about-certs__grid">
        {certifications.map((cert) => (
          <a href={cert.file} class="about-certs__card" target="_blank" rel="noopener noreferrer" download>
            <div class="about-certs__icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                <path d="M12 2l3 3h5v5l3 3-3 3v5h-5l-3 3-3-3H4v-5l-3-3 3-3V5h5l3-3z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="about-certs__name">{cert.name}</span>
            <span class="about-certs__action">PDF</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Factory Tour ===== -->
  <section class="about-tour">
    <div class="container">
      <SectionHeading title="Реальность, которую можно проверить" subtitle="Фабрика, команда, производство — онлайн и лично" />
      <div class="about-tour__grid">
        <div class="about-tour__main">
          <img src="/assets/images/factory/factory-05.jpg" alt="Производственная линия" class="about-tour__img" loading="lazy" />
          <div class="about-tour__main-label">Производственный цех</div>
        </div>
        <div class="about-tour__side">
          <div class="about-tour__side-item">
            <img src="/assets/images/factory/factory-06.jpg" alt="Склад готовой продукции" class="about-tour__side-img" loading="lazy" />
            <span>Склад готовой продукции</span>
          </div>
          <div class="about-tour__side-item">
            <img src="/assets/images/factory/factory-02.jpg" alt="Упаковка" class="about-tour__side-img" loading="lazy" />
            <span>Упаковка и логистика</span>
          </div>
          <div class="about-tour__side-item">
            <img src="/assets/images/factory/factory-10.jpg" alt="Офис" class="about-tour__side-img" loading="lazy" />
            <span>Команда и офис</span>
          </div>
          <div class="about-tour__side-item about-tour__side-item--more">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>Сертификаты</span>
          </div>
        </div>
      </div>
      <div class="about-tour__cta">
        <p>Мы готовы провести онлайн-экскурсию по фабрике, показать производственные линии, склад готовой продукции и отдел контроля качества. Запросите — и мы пришлём свежие фото и видео.</p>
        <a href="/kontakty/" class="about-tour__btn">
          Запросить видео фабрики
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 3l8 8M11 3v8H3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Cooperation Process ===== -->
  <CooperationProcess />

  <!-- ===== Final CTA ===== -->
  <CTASection
    title="Готовы обсудить сотрудничество?"
    subtitle="Напишите нам — мы ответим в течение 24 часов и подготовим индивидуальное предложение."
    ctaText="Написать нам"
    ctaHref="/kontakty/"
  />
</BaseLayout>

<style>
  /* =============================================
     Hero
     ============================================= */
  .about-hero {
    padding: 20px 0 60px;
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-hero__badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(196, 122, 58, 0.12);
    color: var(--color-accent);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 20px;
    letter-spacing: 0.5px;
  }

  .about-hero__content h1 {
    margin-bottom: 16px;
    line-height: 1.15;
  }

  .about-hero__lead {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-primary);
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .about-hero__content p:not(.about-hero__lead) {
    color: var(--color-text-light);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .about-hero__actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
  }

  .about-hero__btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all var(--transition);
  }

  .about-hero__btn--primary {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .about-hero__btn--primary:hover {
    background: var(--color-accent-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    color: var(--color-white);
  }

  .about-hero__btn--secondary {
    background: var(--color-white);
    color: var(--color-primary);
    border: 1px solid var(--color-stone);
  }

  .about-hero__btn--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  /* Visual side */
  .about-hero__visual {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-hero__image-wrap {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--color-stone-light);
  }

  .about-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .about-hero__image-badge {
    position: absolute;
    bottom: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .about-hero__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .about-hero__stat {
    text-align: center;
    padding: 16px 8px;
    background: var(--color-white);
    border-radius: var(--radius);
    border: 1px solid var(--color-stone-light);
  }

  .about-hero__stat strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .about-hero__stat span {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  /* =============================================
     Numbers Strip
     ============================================= */
  .about-numbers {
    padding: 0;
  }

  .about-numbers__strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    background: var(--color-primary);
    border-radius: var(--radius-xl);
    padding: 36px 24px;
  }

  .about-numbers__item {
    flex: 1;
    text-align: center;
  }

  .about-numbers__item strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-white);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .about-numbers__item span {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .about-numbers__divider {
    width: 1px;
    height: 48px;
    background: rgba(255, 255, 255, 0.2);
    margin: 0 8px;
  }

  /* =============================================
     Who We Are
     ============================================= */
  .about-who {
    background: var(--color-white);
  }

  .about-who__card {
    text-align: center;
    padding: 36px 24px;
  }

  .about-who__icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: rgba(196, 122, 58, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    transition: all var(--transition);
  }

  .about-who__card:hover .about-who__icon {
    background: rgba(196, 122, 58, 0.18);
    transform: scale(1.05);
  }

  .about-who__card h3 {
    margin-bottom: 10px;
    font-size: 1.2rem;
  }

  .about-who__card p {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.65;
  }

  /* =============================================
     Why Work With Us
     ============================================= */
  .about-why {
    background: var(--color-bg);
  }

  .about-why__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .about-why__item {
    display: flex;
    gap: 20px;
    padding: 28px;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-stone-light);
    transition: all var(--transition);
  }

  .about-why__item:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .about-why__step {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--color-primary);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .about-why__content h3 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }

  .about-why__content p {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.65;
  }

  /* =============================================
     Certificates
     ============================================= */
  .about-certs {
    background: var(--color-white);
  }

  .about-certs__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .about-certs__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 20px;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    text-decoration: none;
    border: 1px solid transparent;
    transition: all var(--transition);
  }

  .about-certs__card:hover {
    border-color: var(--color-accent);
    background: var(--color-white);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .about-certs__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    transition: color var(--transition);
  }

  .about-certs__card:hover .about-certs__icon {
    color: var(--color-accent);
  }

  .about-certs__name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary);
  }

  .about-certs__action {
    font-size: 0.75rem;
    color: var(--color-text-lighter);
    padding: 4px 14px;
    background: var(--color-white);
    border-radius: 50px;
    border: 1px solid var(--color-stone-light);
    transition: all var(--transition);
  }

  .about-certs__card:hover .about-certs__action {
    background: var(--color-accent);
    color: var(--color-white);
    border-color: var(--color-accent);
  }

  /* =============================================
     Factory Tour
     ============================================= */
  .about-tour {
    background: var(--color-bg);
  }

  .about-tour__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
    margin-bottom: 32px;
  }

  .about-tour__main {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--color-stone-light);
  }

  .about-tour__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    transition: transform 0.6s ease;
  }

  .about-tour__main:hover .about-tour__img {
    transform: scale(1.03);
  }

  .about-tour__main-label {
    position: absolute;
    bottom: 16px;
    left: 16px;
    padding: 8px 18px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .about-tour__side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .about-tour__side-item {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-light);
    border: 1px solid var(--color-stone-light);
    transition: all var(--transition);
  }

  .about-tour__side-item:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .about-tour__side-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
