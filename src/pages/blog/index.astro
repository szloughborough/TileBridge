---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Grid from '../../components/ui/Grid.astro';
import Card from '../../components/ui/Card.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [{ params: {}, props: {} }];
}

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Блог — Полезные статьи о ПВХ-покрытиях"
  description="Руководства по выбору самоклеящейся плитки и 3D панелей. Советы оптовикам, идеи применения, знания о продукте."
>
  <div class="container">
    <Breadcrumb items={[{ label: 'Блог' }]} />
  </div>

  <section class="blog-listing">
    <div class="container">
      <SectionHeading
        title="Блог TileBridge"
        subtitle="Полезные статьи о выборе, применении и покупке ПВХ-покрытий"
      />

      {allPosts.length > 0 ? (
        <>
          <!-- Featured Post -->
          <article class="blog-featured">
            <a href={`/blog/${allPosts[0].slug}/`} class="blog-featured__link">
              <div class="blog-featured__image">
                <img
                  src={allPosts[0].data.image}
                  alt={allPosts[0].data.title}
                  class="blog-featured__img"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <div class="blog-featured__content">
                <span class="blog-post__category">{allPosts[0].data.category}</span>
                <h2>{allPosts[0].data.title}</h2>
                <p>{allPosts[0].data.description}</p>
                <div class="blog-post__meta">
                  <time datetime={allPosts[0].data.date.toISOString()}>
                    {allPosts[0].data.date.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  <span>•</span>
                  <span>{allPosts[0].data.author}</span>
                </div>
              </div>
            </a>
          </article>

          <!-- Remaining Posts -->
          <Grid cols={3}>
            {allPosts.slice(1).map((post) => (
              <Card href={`/blog/${post.slug}/`}>
                <article class="blog-card">
                  <div class="blog-card__image">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="blog-card__img"
                      loading="lazy"
                      onerror="this.style.display='none'"
                    />
                  </div>
                  <div class="blog-card__body">
                    <span class="blog-post__category">{post.data.category}</span>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <div class="blog-post__meta">
                      <time datetime={post.data.date.toISOString()}>
                        {post.data.date.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}
                      </time>
                    </div>
                  </div>
                </article>
              </Card>
            ))}
          </Grid>
        </>
      ) : (
        <div class="blog-empty">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="24" stroke="var(--color-stone)" stroke-width="2"/><path d="M24 28h16M24 36h12" stroke="var(--color-stone)" stroke-width="2"/></svg>
          <p>Статей пока нет. Мы готовим полезные материалы. Подпишитесь на Telegram, чтобы не пропустить.</p>
        </div>
      )}
    </div>
  </section>

  <CTASection
    title="Остались вопросы?"
    subtitle="Напишите нам — мы поможем разобраться и подобрать оптимальное решение."
    ctaText="Задать вопрос"
    ctaHref="/kontakty/"
  />
</BaseLayout>

<style>
  .blog-listing {
    padding: 0 0 80px;
  }

  .blog-featured {
    margin-bottom: 50px;
  }

  .blog-featured__link {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 30px;
    background: var(--color-white);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow);
    transition: transform var(--transition);
  }

  .blog-featured__link:hover {
    transform: translateY(-2px);
  }

  .blog-featured__image {
    height: 100%;
    min-height: 300px;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .blog-featured__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-featured__content {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .blog-featured__content h2 {
    margin: 12px 0;
  }

  .blog-featured__content p {
    color: var(--color-text-light);
  }

  .blog-post__category {
    display: inline-block;
    padding: 4px 12px;
    background: var(--color-bg);
    color: var(--color-primary);
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    align-self: flex-start;
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--color-text-lighter);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .blog-card__image {
    height: 200px;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .blog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-card__body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .blog-card__body h3 {
    font-size: 1.05rem;
    margin: 10px 0;
  }

  .blog-card__body p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    flex: 1;
  }

  .blog-empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--color-text-lighter);
  }

  @media (max-width: 768px) {
    .blog-featured__link {
      grid-template-columns: 1fr;
    }

    .blog-featured__image {
      min-height: 200px;
    }

    .blog-featured__content {
      padding: 24px;
    }
  }
</style>
