---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Grid from '../../components/ui/Grid.astro';
import Card from '../../components/ui/Card.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import ProductGallery from '../../components/ui/ProductGallery.astro';
import InquiryForm from '../../components/sections/InquiryForm.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../../lib/siteConfig';
import { resolveProductMainImage, resolveProductSceneImages, getDecorTag } from '../../lib/productHelpers';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const paths = [];

  for (const product of products) {
    paths.push({
      params: { page: `${product.data.category}/${product.slug}` },
      props: { product, type: 'detail' },
    });
  }

  return paths;
}

function getSpecLabel(key) {
  const labels = {
    material: 'Материал',
    size: 'Размер',
    thickness: 'Толщина',
    surface: 'Поверхность',
    application: 'Применение',
    moq: 'MOQ',
    packaging: 'Упаковка',
    leadTime: 'Срок производства',
  };
  return labels[key] || key;
}

const { product, type } = Astro.props;
const p = product.data;
const allProducts = await getCollection('products');
const relatedProducts = allProducts
  .filter((x) => x.data.category === p.category && x.id !== product.id)
  .sort((a, b) => a.data.weight - b.data.weight)
  .slice(0, 4);

const mainImage = resolveProductMainImage(product);
const sceneImages = resolveProductSceneImages(product);
const categoryConfig = SITE_CONFIG.categories.find(c => c.id === p.category);
---

<BaseLayout
  title={`${p.code} — ${p.title}`}
  description={p.subtitle}
>
  <div class="container">
    <Breadcrumb items={[
      { label: 'Продукция', href: '/productiya/' },
      { label: categoryConfig?.shortTitle || p.category, href: `/productiya/${p.category}/` },
      { label: `${p.code} — ${p.title}` },
    ]} />
  </div>

  <!-- 1. Hero with Product Gallery -->
  <section class="detail-hero">
    <div class="container">
      <div class="detail-hero__grid">
        <div class="detail-hero__gallery">
          <ProductGallery
            mainImage={mainImage}
            sceneImages={sceneImages}
            alt={p.title}
          />
        </div>
        <div class="detail-hero__content">
          <span class="detail-hero__code">{p.code}</span>
          <h1>{p.title}</h1>
          <p class="detail-hero__subtitle">{p.subtitle}</p>

          <!-- Quick spec pills -->
          <div class="detail-hero__pills">
            <span class="detail-hero__pill">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.2"/><path d="M5 4v6M9 4v6" stroke="currentColor" stroke-width="1.2"/></svg>
              {p.specs.size}
            </span>
            <span class="detail-hero__pill">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="5" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2"/><circle cx="7" cy="9" r="2" stroke="currentColor" stroke-width="1.2"/></svg>
              {p.specs.thickness}
            </span>
            <span class="detail-hero__pill">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/><path d="M7 4v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.2"/></svg>
              {p.specs.moq}
            </span>
            {getDecorTag(p.subtitle) && (
              <span class="detail-hero__pill detail-hero__pill--decor">
                {getDecorTag(p.subtitle)}
              </span>
            )}
          </div>

          <div class="detail-hero__actions">
            <a href="#inquiry" class="detail-hero__btn detail-hero__btn--primary">Запросить цену</a>
            <a href="#specs" class="detail-hero__btn detail-hero__btn--secondary">Характеристики</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Specs Table -->
  <section id="specs" class="detail-specs">
    <div class="container">
      <SectionHeading title="Технические характеристики" centered={false} />
      <div class="detail-specs__table">
        {Object.entries(p.specs).map(([key, value]) => (
          <div class="detail-specs__row">
            <span class="detail-specs__label">{getSpecLabel(key)}</span>
            <span class="detail-specs__value">{value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Product Advantages -->
  <section class="detail-advantages">
    <div class="container">
      <SectionHeading title="Преимущества продукта" subtitle="Особенности и выгоды для вашего бизнеса" centered={false} />
      <div class="detail-advantages__list">
        {p.features.map((f) => (
          <div class="detail-advantages__item">
            <div class="detail-advantages__dot"></div>
            <div>
              <strong>{f.feature}</strong>
              <p>{f.benefit}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Applications -->
  <section class="detail-apps">
    <div class="container">
      <SectionHeading title="Области применения" centered={false} />
      <Grid cols={3}>
        {p.applications.map((app) => (
          <Card variant="bordered">
            <div class="detail-apps__item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="var(--color-accent)" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="var(--color-accent)" stroke-width="2"/></svg>
              <span>{app}</span>
            </div>
          </Card>
        ))}
      </Grid>
    </div>
  </section>

  <!-- 5. Customization -->
  <section class="detail-custom">
    <div class="container">
      <SectionHeading title="Возможности кастомизации" subtitle="Адаптируем продукт под ваш бизнес" />
      <Grid cols={2}>
        {p.customization.map((opt) => (
          <div class="detail-custom__item">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2a8 8 0 100 16 8 8 0 000-16z" stroke="var(--color-primary)" stroke-width="1.5"/><path d="M7 10l2 2 4-4" stroke="var(--color-accent)" stroke-width="1.5"/></svg>
            <span>{opt}</span>
          </div>
        ))}
      </Grid>
    </div>
  </section>

  <!-- 6. Packaging & Shipping -->
  <section class="detail-shipping">
    <div class="container">
      <SectionHeading title="Упаковка и доставка" centered={false} />
      <div class="detail-shipping__grid">
        <div class="detail-shipping__card">
          <h4>Упаковка</h4>
          <p>{p.specs.packaging}</p>
        </div>
        <div class="detail-shipping__card">
          <h4>MOQ</h4>
          <p>{p.specs.moq}</p>
        </div>
        <div class="detail-shipping__card">
          <h4>Срок производства</h4>
          <p>{p.specs.leadTime}</p>
        </div>
        <div class="detail-shipping__card">
          <h4>Доставка в РФ</h4>
          <p>Море 25–35 дн. / Ж/Д 15–20 дн. / Авиа 5–7 дн.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Quality Control -->
  <section class="detail-qc">
    <div class="container">
      <SectionHeading title="Контроль качества" subtitle="Каждая партия проходит проверку" centered={false} />
      <div class="detail-qc__content">
        <p>Вся продукция проходит контроль на каждом этапе производства: от входного контроля сырья до финальной проверки готовой партии.</p>
        <a href="/kontrol-kachestva/" class="detail-qc__link">Подробнее о контроле качества →</a>
      </div>
    </div>
  </section>

  <!-- 8. Related Products -->
  {relatedProducts.length > 0 && (
    <section class="detail-related">
      <div class="container">
        <SectionHeading title="Похожие продукты" />
        <div class="detail-related__grid">
          {relatedProducts.map((rp) => {
            const decor = getDecorTag(rp.data.subtitle);
            return (
              <ProductCard
                product={rp}
                href={`/productiya/${rp.data.category}/${rp.slug}/`}
                decor={decor}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- 9. Final CTA / Inquiry -->
  <section id="inquiry" class="detail-inquiry">
    <div class="container">
      <SectionHeading
        title="Запросить коммерческое предложение"
        subtitle="Отправьте запрос — мы подготовим цены, сроки и отправим образцы"
      />
      <InquiryForm productTitle={p.title} />
    </div>
  </section>

  <CTASection
    title={`Хотите образец ${p.code}?`}
    subtitle={`Закажите образец плитки ${p.title} для оценки качества перед заказом.`}
    ctaText="Заказать образец"
    ctaHref="#inquiry"
  />

  <!-- Sticky Mobile CTA -->
  <div class="sticky-mobile-cta">
    <a href="#inquiry" class="sticky-mobile-cta__btn">Запросить цену</a>
  </div>
</BaseLayout>

<style>
  /* Hero */
  .detail-hero {
    padding: 40px 0 60px;
    background: var(--color-white);
  }

  .detail-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: start;
  }

  .detail-hero__gallery {
    position: sticky;
    top: 24px;
  }

  .detail-hero__code {
    display: inline-block;
    padding: 4px 12px;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .detail-hero__subtitle {
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin: 16px 0 24px;
  }

  .detail-hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .detail-hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--color-bg-light);
    border: 1px solid var(--color-stone-light);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-light);
  }

  .detail-hero__pill--decor {
    background: rgba(196, 122, 58, 0.08);
    border-color: rgba(196, 122, 58, 0.2);
    color: var(--color-accent);
  }

  .detail-hero__actions {
    display: flex;
    gap: 12px;
  }

  .detail-hero__btn {
    display: inline-flex;
    padding: 14px 28px;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all var(--transition);
  }

  .detail-hero__btn--primary {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .detail-hero__btn--primary:hover {
    background: var(--color-accent-dark);
    color: var(--color-white);
  }

  .detail-hero__btn--secondary {
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
  }

  .detail-hero__btn--secondary:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }

  /* Specs */
  .detail-specs { background: var(--color-bg); }

  .detail-specs__table {
    max-width: 700px;
    background: var(--color-white);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .detail-specs__row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    padding: 14px 24px;
    border-bottom: 1px solid var(--color-stone-light);
  }

  .detail-specs__row:last-child { border-bottom: none; }

  .detail-specs__label {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.9rem;
  }

  .detail-specs__value {
    color: var(--color-text);
    font-size: 0.9rem;
  }

  /* Advantages */
  .detail-advantages { background: var(--color-white); }

  .detail-advantages__list { display: grid; gap: 20px; }

  .detail-advantages__item {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--color-bg-light);
    border-radius: var(--radius);
  }

  .detail-advantages__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
    margin-top: 6px;
    flex-shrink: 0;
  }

  .detail-advantages__item strong {
    display: block;
    margin-bottom: 4px;
    color: var(--color-primary);
  }

  .detail-advantages__item p {
    color: var(--color-text-light);
    margin: 0;
    font-size: 0.9rem;
  }

  /* Applications */
  .detail-apps { background: var(--color-bg); }

  .detail-apps__item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.95rem;
  }

  /* Customization */
  .detail-custom { background: var(--color-white); }

  .detail-custom__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: var(--color-bg-light);
    border-radius: var(--radius);
  }

  /* Shipping */
  .detail-shipping { background: var(--color-bg); }

  .detail-shipping__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .detail-shipping__card {
    padding: 24px;
    background: var(--color-white);
    border-radius: var(--radius);
    text-align: center;
  }

  .detail-shipping__card h4 { margin-bottom: 8px; font-size: 1rem; }

  .detail-shipping__card p {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin: 0;
  }

  /* QC */
  .detail-qc { background: var(--color-white); }

  .detail-qc__content {
    padding: 24px;
    background: var(--color-bg-light);
    border-radius: var(--radius);
    border-left: 4px solid var(--color-accent);
  }

  .detail-qc__link { color: var(--color-accent); font-weight: 600; }

  /* Related */
  .detail-related { background: var(--color-bg); }

  .detail-related__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  /* Inquiry */
  .detail-inquiry { background: var(--color-white); }

  /* Sticky Mobile CTA */
  .sticky-mobile-cta {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 12px 20px;
    background: var(--color-white);
    box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
  }

  .sticky-mobile-cta__btn {
    display: block;
    width: 100%;
    padding: 14px;
    background: var(--color-accent);
    color: var(--color-white);
    text-align: center;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .detail-hero__grid {
      grid-template-columns: 1fr;
    }

    .detail-hero__gallery {
      position: static;
    }

    .detail-shipping__grid {
      grid-template-columns: 1fr 1fr;
    }

    .detail-related__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .sticky-mobile-cta {
      display: block;
    }

    /* Add bottom padding to prevent content from being hidden behind sticky CTA */
    .detail-inquiry {
      padding-bottom: 80px;
    }
  }
</style>
