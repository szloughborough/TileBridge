---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import CTASection from '../../../components/sections/CTASection.astro';
import InquiryForm from '../../../components/sections/InquiryForm.astro';
import ProductCard from '../../../components/ui/ProductCard.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../../../lib/siteConfig';
import { getDecorTag, DECOR_TAGS, getStyleTag, STYLE_TAGS } from '../../../lib/productHelpers';

export async function getStaticPaths() {
  return [{ params: {}, props: {} }];
}

const allProducts = await getCollection('products');
const products = allProducts
  .filter((p) => p.data.category === 'floor-tiles')
  .sort((a, b) => a.data.weight - b.data.weight);
const category = SITE_CONFIG.categories[0];

const hotProducts = new Set();
products.slice(0, 8).forEach(p => hotProducts.add(p.id));
---

<BaseLayout
  title="Плитка для пола FT — Самоклеящаяся ПВХ плитка"
  description="Самоклеящаяся ПВХ плитка для пола. Мрамор, дерево, бетон, геометрия. Множество видов. Оптом от производителя."
>
  <div class="container">
    <Breadcrumb items={[
      { label: 'Продукция', href: '/productiya/' },
      { label: category.shortTitle },
    ]} />
  </div>

  <section class="products-page">
    <div class="container">
      <SectionHeading
        title={category.shortTitle}
        subtitle={category.description}
      />

      <div class="products__category-info">
        <h3>{category.title}</h3>
        <p>{category.description}</p>
      </div>

      <!-- Decor Filter -->
      <div class="products__decor-filters">
        <button class="decor-filter active" data-decor="all">Все</button>
        {DECOR_TAGS.map(tag => (
          <button class="decor-filter" data-decor={tag}>{tag}</button>
        ))}
      </div>

      <!-- Style Filter -->
      <div class="products__style-filters">
        <span class="filter-label">Стиль:</span>
        <button class="style-filter active" data-style="all">Все</button>
        {STYLE_TAGS.map(tag => (
          <button class="style-filter" data-style={tag}>{tag}</button>
        ))}
      </div>

      {products.length > 0 ? (
        <div class="products__items">
          {products.map((product, i) => {
            const decor = getDecorTag(product.data.subtitle);
            const style = getStyleTag(product, decor);
            return (
              <ProductCard
                product={product}
                href={`/productiya/floor-tiles/${product.slug}/`}
                decor={decor}
                style={style}
                isHot={hotProducts.has(product.id)}
                eager={i < 12}
              />
            );
          })}
        </div>
      ) : (
        <div class="products__empty">
          <p>Нет товаров в этой категории.</p>
        </div>
      )}

      <div class="products__no-results" id="no-results" style="display:none;">
        <p>Нет товаров по выбранным фильтрам.</p>
        <button class="decor-filter reset-filter" data-decor="all">Показать все</button>
      </div>

      <div style="text-align:center;margin-top:40px;">
        <a href="/productiya/" class="hero__btn hero__btn--secondary">← Все категории</a>
      </div>
    </div>
  </section>

  <!-- Inquiry Section -->
  <section id="inquiry" class="detail-inquiry">
    <div class="container">
      <SectionHeading
        title="Получить оптовые цены"
        subtitle="Отправьте запрос — мы подготовим цены, сроки и отправим образцы"
      />
      <InquiryForm />
    </div>
  </section>

  <CTASection
    title="Нужна консультация по плитке?"
    subtitle="Поможем подобрать плитку для вашего проекта. Отправьте запрос — получите цены и образцы."
    ctaText="Получить консультацию"
    ctaHref="#inquiry"
  />

  <script>
    // State: current active filters
    let activeDecor = 'all';
    let activeStyle = 'all';

    const decorBtns = document.querySelectorAll('.decor-filter');
    const styleBtns = document.querySelectorAll('.style-filter');
    const noResults = document.getElementById('no-results');

    function applyFilters() {
      const items = document.querySelectorAll('.product-card');

      let visibleCount = 0;
      items.forEach((card) => {
        const matchDecor = activeDecor === 'all' || card.dataset.decor === activeDecor;
        const matchStyle = activeStyle === 'all' || card.dataset.style === activeStyle;
        if (matchDecor && matchStyle) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Decor type filters
    decorBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        decorBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeDecor = btn.dataset.decor;
        applyFilters();
      });
    });

    // Style filters
    styleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        styleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeStyle = btn.dataset.style;
        applyFilters();
      });
    });
  </script>
</BaseLayout>

<style>
  .products-page {
    padding: 0 0 80px;
  }

  .products__category-info {
    margin-bottom: 30px;
    padding: 24px;
    background: var(--color-white);
    border-radius: var(--radius);
    border-left: 4px solid var(--color-accent);
  }

  .products__category-info h3 { margin-bottom: 8px; }

  .products__category-info p {
    color: var(--color-text-light);
    margin: 0;
  }

  /* Decor filters */
  .products__decor-filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .decor-filter {
    padding: 6px 14px;
    border: 1.5px solid var(--color-stone-light);
    border-radius: 20px;
    background: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-light);
    cursor: pointer;
    transition: all var(--transition);
  }

  .decor-filter:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .decor-filter.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  .reset-filter {
    margin-top: 12px;
    padding: 10px 24px;
    font-size: 0.9rem;
  }

  .products__items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .products__empty,
  .products__no-results {
    text-align: center;
    padding: 60px 20px;
    background: var(--color-white);
    border-radius: var(--radius-lg);
  }

  .products__empty p,
  .products__no-results p {
    color: var(--color-text-light);
    font-size: 1.1rem;
    margin-bottom: 16px;
  }

  /* Style filters */
  .products__style-filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 24px;
  }

  .products__style-filters .filter-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-light);
    margin-right: 4px;
  }

  .style-filter {
    padding: 6px 14px;
    border: 1.5px solid var(--color-stone-light);
    border-radius: 20px;
    background: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-light);
    cursor: pointer;
    transition: all var(--transition);
  }

  .style-filter:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .style-filter.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-white);
  }

  .hero__btn--secondary {
    display: inline-flex;
    padding: 14px 28px;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: all var(--transition);
  }

  .hero__btn--secondary:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .detail-inquiry { background: var(--color-bg); }
</style>
